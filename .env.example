TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Required: numeric Telegram user ID of the bot owner (no default)
OWNER_TELEGRAM_ID=123456789
# Required: valid Fernet key (AES-128-CBC + HMAC-SHA256).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_generated_fernet_key
# Public URL where the Telegram Mini App is served (optional locally)
WEBAPP_URL=https://your-app.onrender.com
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:5432/postgres
